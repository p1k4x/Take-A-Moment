{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Take A Moment",
  "version": "0.11.6",
  "identifier": "app.take-a-moment",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "publisher": "Take A Moment",
    "category": "Utility",
    "homepage": "https://github.com/p1k4x/Take-A-Moment",
    "shortDescription": "A gentle break-reminder that lives in the system tray",
    "longDescription": "Fullscreen break overlays with configurable reminders. The Debian package uses system WebKitGTK and GStreamer.",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../assets/icons": "icons",
      "../src/public/videos": "videos"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "section": "utils",
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad"
        ],
        "recommends": ["playerctl"],
        "desktopTemplate": "linux/take-a-moment.desktop",
        "preRemoveScript": "linux/prerm",
        "postInstallScript": "linux/postinst",
        "postRemoveScript": "linux/postrm"
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": ["Swedish"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsi"
      }
    }
  }
}
